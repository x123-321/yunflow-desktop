{
  "name": "yunflow-desktop",
  "version": "1.0.1",
  "description": "YunFlow 云流 — 多连接分片并发的桌面端网盘下载加速器",
  "license": "AGPL-3.0-or-later",
  "author": "YunFlow Contributors",
  "private": false,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "node scripts/start.mjs",
    "demo": "node scripts/demo-server.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "package": "npm run build && node scripts/package-portable.mjs",
    "postinstall": "node scripts/patch-electron-builder.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "io.github.yunflow.desktop",
    "productName": "YunFlow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
 "files": [
  "dist/**/*",
  "assets/**/*",
  "package.json",
  "LICENSE",
  "NOTICE"
 ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "YunFlow 云流",
      "uninstallDisplayName": "YunFlow 云流 (多网盘下载加速器)",
      "artifactName": "YunFlow-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  },
  "productName": "YunFlow"
}